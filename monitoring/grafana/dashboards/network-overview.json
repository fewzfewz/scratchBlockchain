{
  "dashboard": {
    "title": "Modular Blockchain - Network Overview",
    "tags": ["blockchain", "modular", "testnet"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Finalized Height",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "blockchain_finalized_height",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Transaction Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(blockchain_transactions_total[5m])",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Active Validators",
        "type": "stat",
        "gridPos": {"x": 0, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "max(blockchain_validator_count)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Total Stake",
        "type": "stat",
        "gridPos": {"x": 6, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "max(blockchain_validator_stake_total)",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Peer Count",
        "type": "stat",
        "gridPos": {"x": 12, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "blockchain_peer_count",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Pending Transactions",
        "type": "stat",
        "gridPos": {"x": 18, "y": 8, "w": 6, "h": 4},
        "targets": [
          {
            "expr": "blockchain_mempool_size",
            "refId": "A"
          }
        ]
      },
      {
        "id": 7,
        "title": "Consensus Round",
        "type": "graph",
        "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "blockchain_consensus_round",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 8,
        "title": "Block Time (s)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "1 / rate(blockchain_blocks_total[5m])",
            "legendFormat": "{{instance}}",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
